# Doorstep environment variables
#
# Copy to .env.local for local development. Values are populated by later
# milestones as each integration (Firebase, Neon, Meilisearch, Mapbox,
# Resend, Upstash, Stripe) is wired up. Do not commit real secrets.

# Postgres (Neon in prod/preview). Required by drizzle.config.ts and
# adapters/drizzle/client.ts. Must have the postgis and citext extensions
# available (see src/adapters/drizzle/migrations/0000_enable_extensions.sql).
DATABASE_URL=postgres://user:password@localhost:5432/doorstep

# Set only in CI / when a disposable Postgres+PostGIS service container is
# available. tests/integration/db.schema.test.ts skips cleanly when unset —
# there is no live database on local dev machines without Docker.
TEST_DATABASE_URL=

# Firebase Auth (PRD §8.4). The client (NEXT_PUBLIC_*) config comes from
# the Firebase console's web app settings — these are not secret, they
# are shipped to the browser. The Admin SDK vars (FIREBASE_*, no
# NEXT_PUBLIC_ prefix) come from a service account key and ARE secret —
# never commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=doorstep-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=doorstep-dev
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Admin SDK service account (src/adapters/firebase/admin-app.ts). Server
# only, never exposed to the client.
#
# Hosted env-var UIs (Vercel): prefer FIREBASE_SERVICE_ACCOUNT_B64 — the
# whole service-account JSON base64-encoded to one line, which survives
# any paste intact (generate with: base64 -i service-account.json).
# When set, it takes precedence over the three separate variables below.
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=doorstep-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@doorstep-dev.iam.gserviceaccount.com
# Multi-line PEM key stored with literal \n escapes — most hosting env-var
# UIs (including Vercel's) don't preserve real newlines in one value.
# admin-app.ts unescapes \n back into a real PEM before use.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Storage bucket (src/adapters/firebase/firebase-storage-adapter.ts,
# PRD §8.7). Not secret — the bucket name, not a credential. Required for
# the image pipeline (POST /api/v1/listings/{id}/images and friends);
# createServices() throws a clear error naming this var if it's unset.
# FIREBASE_STORAGE_BUCKET=my-project.firebasestorage.app

# Set only to run tests/integration/image-storage-firebase.contract.test.ts
# against a real bucket (PRD §8.7's storage-adapter contract-test exit
# criterion) — unset in CI, where it skips cleanly; the in-memory fake's
# contract run (image-storage-inmemory.contract.test.ts) still enforces
# the contract there. Uses a doorstep-contract-test/ path prefix and
# cleans up after itself.
# TEST_FIREBASE_STORAGE_BUCKET=my-project.firebasestorage.app

# Run `pnpm emulator:storage` (firebase.json/storage.rules at the repo
# root) and set this to develop the image pipeline — signed upload, sharp
# variants, public URLs — with no live Storage bucket at all. The real
# FirebaseStorageAdapter (src/adapters/firebase/firebase-storage-adapter.ts)
# redirects to the emulator when this is set; FIREBASE_STORAGE_BUCKET can
# stay whatever it already is, since under emulation it's just a path
# prefix, not a bucket that has to exist. See the README's "Firebase
# Storage emulator" section. Also gates
# tests/integration/image-storage-firebase-emulator.contract.test.ts,
# which runs in CI on every push.
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Optional: overrides the session cookie's name (src/lib/session.ts).
# Defaults to __session when unset.
SESSION_COOKIE_NAME=

# Meilisearch (src/adapters/meilisearch/, PRD §8.6). MEILISEARCH_HOST is
# required to construct MeilisearchSearchIndex; MEILISEARCH_API_KEY is the
# instance's master/API key (omit for a daemon running with none, e.g.
# local dev without --master-key). MEILISEARCH_INDEX_PREFIX namespaces
# the index this adapter reads/writes ("{prefix}-listings") — defaults to
# "doorstep" when unset, so this only needs setting to run more than one
# environment (dev, CI, a preview deploy) against the same Meilisearch
# instance without their documents colliding.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=doorstep

# Set only to run tests/integration/meilisearch-adapter.test.ts against a
# real daemon (unset in CI's own env block — that job wires these two
# directly, see .github/workflows/ci.yml) — every other suite skips
# cleanly without them. Each run creates its own disposable, randomly
# named index and deletes it again in afterAll, so this is safe to point
# at a shared daemon (e.g. the local dev one below).
#   TEST_MEILISEARCH_HOST=http://127.0.0.1:7700 \
#   TEST_MEILISEARCH_API_KEY=local-dev-master-key \
#   pnpm test:integration
# TEST_MEILISEARCH_HOST=
# TEST_MEILISEARCH_API_KEY=

# Mapbox Geocoding (src/adapters/mapbox/, PRD §8.6, §10 SRCH-1). Optional:
# when set, lib/composition.ts wires MapboxGeocoder as the free-text place
# search provider (GB-biased forward geocoding + autocomplete); when unset,
# adapters/postcodesio/'s own free, keyless Places API (OS Open Names GB)
# is used instead — see adapters/mapbox/'s doc comment for why this is a
# documented deviation from the PRD's "Mapbox is the free-text provider"
# framing, not an oversight. No token is provisioned in this project's
# local/CI environments yet. Get one at https://account.mapbox.com/ — a
# public token (pk.*) is sufficient for the Geocoding API endpoints this
# adapter calls. tests/integration/mapbox-geocoder.test.ts `skipIf`s
# cleanly without it; tests/unit/adapters/mapbox/ (mocked fetch) always
# runs regardless.
# MAPBOX_ACCESS_TOKEN=

# Authorizes app/api/cron/outbox-drain and app/api/cron/reindex
# (src/lib/verify-cron-request.ts, PRD §8.6). Vercel attaches
# `Authorization: Bearer ${CRON_SECRET}` automatically to its own
# scheduled requests once this is set on the project — generate a random
# value (e.g. `openssl rand -hex 32`) and set the same value here for
# local manual testing (curl -H "Authorization: Bearer $CRON_SECRET" ...).
# Both routes reject every request with a 401 while this is unset.
CRON_SECRET=
