# Doorstep environment variables
#
# Copy to .env.local for local development. Values are populated by later
# milestones as each integration (Firebase, Neon, Meilisearch, Mapbox,
# Resend, Upstash, Stripe) is wired up. Do not commit real secrets.

# Postgres (Neon in prod/preview). Required by drizzle.config.ts and
# adapters/drizzle/client.ts. Must have the postgis and citext extensions
# available (see src/adapters/drizzle/migrations/0000_enable_extensions.sql).
DATABASE_URL=postgres://user:password@localhost:5432/doorstep

# Set only in CI / when a disposable Postgres+PostGIS service container is
# available. tests/integration/db.schema.test.ts skips cleanly when unset —
# there is no live database on local dev machines without Docker.
TEST_DATABASE_URL=
