# Doorstep environment variables
#
# Copy to .env.local for local development. Values are populated by later
# milestones as each integration (Firebase, Neon, Meilisearch, Mapbox,
# Resend, Upstash, Stripe) is wired up. Do not commit real secrets.

# Postgres (Neon in prod/preview). Required by drizzle.config.ts and
# adapters/drizzle/client.ts. Must have the postgis and citext extensions
# available (see src/adapters/drizzle/migrations/0000_enable_extensions.sql).
DATABASE_URL=postgres://user:password@localhost:5432/doorstep

# Set only in CI / when a disposable Postgres+PostGIS service container is
# available. tests/integration/db.schema.test.ts skips cleanly when unset —
# there is no live database on local dev machines without Docker.
TEST_DATABASE_URL=

# Firebase Auth (PRD §8.4). The client (NEXT_PUBLIC_*) config comes from
# the Firebase console's web app settings — these are not secret, they
# are shipped to the browser. The Admin SDK vars (FIREBASE_*, no
# NEXT_PUBLIC_ prefix) come from a service account key and ARE secret —
# never commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=doorstep-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=doorstep-dev
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Admin SDK service account (src/adapters/firebase/admin-app.ts). Server
# only, never exposed to the client.
#
# Hosted env-var UIs (Vercel): prefer FIREBASE_SERVICE_ACCOUNT_B64 — the
# whole service-account JSON base64-encoded to one line, which survives
# any paste intact (generate with: base64 -i service-account.json).
# When set, it takes precedence over the three separate variables below.
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=doorstep-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@doorstep-dev.iam.gserviceaccount.com
# Multi-line PEM key stored with literal \n escapes — most hosting env-var
# UIs (including Vercel's) don't preserve real newlines in one value.
# admin-app.ts unescapes \n back into a real PEM before use.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Storage bucket (src/adapters/firebase/firebase-storage-adapter.ts,
# PRD §8.7). Not secret — the bucket name, not a credential. Required for
# the image pipeline (POST /api/v1/listings/{id}/images and friends);
# createServices() throws a clear error naming this var if it's unset.
# FIREBASE_STORAGE_BUCKET=my-project.firebasestorage.app

# Set only to run tests/integration/image-storage-firebase.contract.test.ts
# against a real bucket (PRD §8.7's storage-adapter contract-test exit
# criterion) — unset in CI, where it skips cleanly; the in-memory fake's
# contract run (image-storage-inmemory.contract.test.ts) still enforces
# the contract there. Uses a doorstep-contract-test/ path prefix and
# cleans up after itself.
# TEST_FIREBASE_STORAGE_BUCKET=my-project.firebasestorage.app

# Optional: overrides the session cookie's name (src/lib/session.ts).
# Defaults to __session when unset.
SESSION_COOKIE_NAME=
