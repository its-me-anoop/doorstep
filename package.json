{
  "name": "doorstep",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:unit": "pnpm --filter web test:unit",
    "test:integration": "pnpm --filter web test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "seed": "pnpm --filter web seed",
    "seed:search-5k": "pnpm --filter web seed:search-5k",
    "seed:search-5k:clean": "pnpm --filter web seed:search-5k:clean",
    "bench:search": "pnpm --filter web bench:search",
    "assert:map-bundle-isolation": "pnpm --filter web assert:map-bundle-isolation",
    "emulator:storage": "firebase emulators:start --only storage --project my-shop-cdeac"
  }
}
